# 복사해서 .env 로 사용하세요: cp .env.example .env
TZ=Asia/Seoul
# 앱 이미지 태그 (backend/vision/frontend 공통)
IMAGE_TAG=local

# ---- PostgreSQL ----
POSTGRES_USER=neurovector
POSTGRES_PASSWORD=neurovector
POSTGRES_DB=neurovector
POSTGRES_PORT=5432
DATABASE_MAX_CONNECTIONS=10

# ---- Redis ----
REDIS_PASSWORD=neurovector
REDIS_PORT=6379

# ---- Kafka ----
KAFKA_PORT=9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_NUM_PARTITIONS=3
KAFKA_UI_PORT=8080
KAFKA_TOPIC_EVENTS=neurovector.events
KAFKA_TOPIC_ORDERS=neurovector.orders

# ---- Redis cache ----
CACHE_ENABLED=true
CACHE_TTL_SECONDS=30

# ---- 관리자 세션 로그인 ----
# 최초 기동 시 이 계정이 생성됩니다. 비밀번호를 바꾸면 기존 세션이 폐기됩니다.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=neurovector-admin
ADMIN_SESSION_TTL_SECONDS=86400
# HTTPS 배포 시 true 로 설정하세요.
ADMIN_COOKIE_SECURE=false
# Optional card nickname/last-four storage: base64-encoded random 32-byte key.
# Generate outside the repository with: openssl rand -base64 32
# Back up the key separately from PostgreSQL; losing/changing it makes old cards unreadable.
CARD_METADATA_KEY=
# *이면 모든 Origin 허용 (자격 증명 요청은 요청 Origin을 그대로 응답)
CORS_ALLOWED_ORIGINS=*

# ---- MQTT (Mosquitto) ----
MQTT_PORT=1883
MQTT_USERNAME=neurovector
MQTT_PASSWORD=neurovector
MQTT_CLIENT_ID=neurovector-backend
MQTT_TOPIC_PREFIX=neurovector
MQTT_QOS=1
# 드론별 계정 예시: drone-001:secret,drone-002:secret
MQTT_EXTRA_USERS=

# ---- 미디어 (MediaMTX: SRT + WebRTC + 녹화) ----
MEDIA_SRT_PORT=8890
MEDIA_WEBRTC_PORT=8889
MEDIA_WEBRTC_ICE_PORT=8189
MEDIA_API_PORT=9997
# 브라우저가 접근할 호스트 (원격 서버라면 공인 IP/도메인으로 변경)
MEDIA_SRT_PUBLIC_HOST=localhost
MEDIA_WEBRTC_ADDITIONAL_HOSTS=localhost

# ---- 경로 검증 / 위험 예측 ----
MAX_ALTITUDE_M=120
ROUTE_MAX_LEG_M=5000
ROUTE_MAX_DISTANCE_M=20000
ROUTE_BATTERY_WH=500
ROUTE_POWER_W=300
RISK_LOOKBACK_DAYS=90
RISK_CORRIDOR_M=150
TELEMETRY_ONLINE_TTL_SECONDS=120

# ---- 애플리케이션 포트 ----
BACKEND_PORT=8081
VISION_PORT=8082
FRONTEND_PORT=5173

# ---- 애플리케이션 설정 ----
RUST_LOG=info,tower_http=debug
DRONE_ID=drone-001
# 1 로 설정하면 vision 이미지에 YOLO/OpenCV 를 포함해 빌드합니다 (용량 큼)
VISION_WITH_MODEL=0
VISION_MODEL_PATH=yolov8n.pt
VISION_CONFIDENCE_THRESHOLD=0.35
VISION_BACKEND_TIMEOUT=5.0
# 단안 거리 추정: 카메라 수평 화각(도)
VISION_CAMERA_HORIZONTAL_FOV_DEG=70
# 파인튜닝 클래스 크기 JSON (기본 표에 없는 클래스만 추가해도 됨)
# VISION_OBJECT_SIZES={"fallen_tree":{"width_m":3.0,"height_m":1.0}}

# ---- 시뮬레이션 (sim 프로필) ----
# sim 레포의 sim/.env.example 도 함께 참고하세요.
SIM_BASE_IMAGE=px4io/px4-sitl-gazebo-ros2:latest
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
PX4_SIM_MODEL=gz_x500_depth
PX4_GZ_WORLD=default
HEADLESS=0
LIBGL_ALWAYS_SOFTWARE=0

# ---- 고객 소셜 로그인 (서버 전용; VITE_ 변수에 시크릿을 넣지 마세요) ----
# 브라우저가 사용하는 사이트 원점. HTTPS 운영 주소와 콜백 주소의 호스트를 일치시키세요.
OAUTH_FRONTEND_URL=http://localhost:5173
# 카카오 CLIENT_ID는 REST API 키입니다. 시크릿 사용 설정 시 CLIENT_SECRET도 입력하세요.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/api/v1/auth/oauth/kakao/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:5173/api/v1/auth/oauth/naver/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/oauth/google/callback
# 자세한 공급자 콘솔 설정과 배포 절차: backend/OAUTH.md

# ---- API 키 입력란 ----
# 카카오 API 키 입력
KAKAO_API_KEY=
# 네이버 API 키 입력
NAVER_API_KEY=
# 구글 API 키 입력
GOOGLE_API_KEY=
