# 복사해서 .env 로 사용하세요: cp .env.example .env
TZ=Asia/Seoul
# 앱 이미지 태그 (backend/vision/frontend 공통)
IMAGE_TAG=local

# ---- PostgreSQL ----
POSTGRES_USER=neurovector
POSTGRES_PASSWORD=neurovector
POSTGRES_DB=neurovector
POSTGRES_PORT=5432
DATABASE_MAX_CONNECTIONS=10

# ---- Redis ----
REDIS_PASSWORD=neurovector
REDIS_PORT=6379

# ---- Kafka ----
KAFKA_PORT=9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_NUM_PARTITIONS=3
KAFKA_UI_PORT=8080
KAFKA_TOPIC_EVENTS=neurovector.events
KAFKA_TOPIC_ORDERS=neurovector.orders

# ---- Redis cache ----
CACHE_ENABLED=true
CACHE_TTL_SECONDS=30

# ---- MQTT (Mosquitto) ----
MQTT_PORT=1883
MQTT_USERNAME=neurovector
MQTT_PASSWORD=neurovector
MQTT_CLIENT_ID=neurovector-backend
MQTT_TOPIC_PREFIX=neurovector
MQTT_QOS=1
# 드론별 계정 예시: drone-001:secret,drone-002:secret
MQTT_EXTRA_USERS=

# ---- 미디어 (MediaMTX: SRT + WebRTC + 녹화) ----
MEDIA_SRT_PORT=8890
MEDIA_WEBRTC_PORT=8889
MEDIA_WEBRTC_ICE_PORT=8189
MEDIA_API_PORT=9997
# 브라우저가 접근할 호스트 (원격 서버라면 공인 IP/도메인으로 변경)
MEDIA_SRT_PUBLIC_HOST=localhost
MEDIA_WEBRTC_ADDITIONAL_HOSTS=localhost

# ---- 경로 검증 / 위험 예측 ----
MAX_ALTITUDE_M=120
ROUTE_MAX_LEG_M=5000
ROUTE_MAX_DISTANCE_M=20000
ROUTE_BATTERY_WH=500
ROUTE_POWER_W=300
RISK_LOOKBACK_DAYS=90
RISK_CORRIDOR_M=150
TELEMETRY_ONLINE_TTL_SECONDS=120

# ---- 애플리케이션 포트 ----
BACKEND_PORT=8081
VISION_PORT=8082
FRONTEND_PORT=5173

# ---- 애플리케이션 설정 ----
RUST_LOG=info,tower_http=debug
DRONE_ID=drone-001
# 1 로 설정하면 vision 이미지에 YOLO/OpenCV 를 포함해 빌드합니다 (용량 큼)
VISION_WITH_MODEL=0
VISION_MODEL_PATH=yolov8n.pt
VISION_CONFIDENCE_THRESHOLD=0.35
VISION_BACKEND_TIMEOUT=5.0

# ---- 시뮬레이션 (sim 프로필) ----
# sim 레포의 sim/.env.example 도 함께 참고하세요.
SIM_BASE_IMAGE=px4io/px4-sitl-gazebo-ros2:latest
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
PX4_SIM_MODEL=gz_x500_depth
PX4_GZ_WORLD=default
HEADLESS=0
LIBGL_ALWAYS_SOFTWARE=0
