[Unit]
Description=NeuroVector continuous workspace checks
After=docker.service

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=@WORKSPACE@
ExecStart=/bin/bash @WORKSPACE@/infra/ci/watch.sh check
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
KillMode=control-group
UMask=0077

[Install]
WantedBy=default.target
